# --- required ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
SPLUS_BOT_TOKEN=
SPLUS_OWNER_CHAT_ID=
# PIN you type after `sudo ...` in chat. `make setup` generates API_TOKEN and SUDO_PIN if empty.
SUDO_PIN=
API_TOKEN=
# --- optional ---
# Telegram proxy: socks5://host:port (127.0.0.1 -> docker gateway, socks5 -> socks5h done by make). Empty = direct.
TELEGRAM_PROXY=
# Third chat button (next to "/" and "~"). Both empty = no third button.
MAIN_BUTTON_TEXT=
MAIN_BUTTON_PATH=
# pip mirror used when building the image (default https://pypi.org/simple)
PIP_INDEX=
